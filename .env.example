# GEMINI_API_KEY: Chave de API necessária para chamadas aos modelos Google Gemini.
# O AI Studio injeta automaticamente em tempo de execução a partir dos segredos do usuário.
# O usuário configura isso através do painel de Segredos na interface.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: A URL onde este app está hospedado.
# O AI Studio injeta automaticamente em tempo de execução com a URL do serviço Cloud Run.
# Usado para links auto-referenciais e endpoints de API.
APP_URL="MY_APP_URL"
